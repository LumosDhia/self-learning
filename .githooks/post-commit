#!/bin/sh
# This repo feeds the "Course" widget on the sidoplan dashboard
# (../sidoplan). Whenever a checklist commit happens here, refresh
# sidoplan's course.json so the widget stays in sync automatically.
repo_root="$(git rev-parse --show-toplevel)"
sidoplan_dir="$repo_root/../sidoplan"

if [ -f "$sidoplan_dir/scripts/gen_course.py" ]; then
    python "$sidoplan_dir/scripts/gen_course.py" >/dev/null 2>&1 \
        || python3 "$sidoplan_dir/scripts/gen_course.py" >/dev/null 2>&1
    git -C "$sidoplan_dir" add course.json >/dev/null 2>&1
fi
